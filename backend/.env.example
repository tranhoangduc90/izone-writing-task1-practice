NODE_ENV=production
PORT=8790
DATABASE_URL=postgresql://writing_practice_api:CHANGE_ME@postgres-hostname:5432/izone
DB_POOL_MAX=8
ALLOWED_ORIGINS=https://example.invalid
TRUST_PROXY_HOPS=1
INTERNAL_API_TOKEN=change-this-to-a-random-32-character-minimum-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
TEACHER_SESSION_IDLE_DAYS=90
TEACHER_SESSION_ABSOLUTE_DAYS=365
TEACHER_SESSION_COOKIE_NAME=izone_teacher_session
TEACHER_SESSION_COOKIE_PATH=/writing-api
TEACHER_SESSION_COOKIE_SECURE=true
TEACHER_SESSION_COOKIE_PARTITIONED=true
TEACHER_SESSION_COOKIE_SAME_SITE=none
PROVISIONAL_STUDENT_PIN_PEPPER=replace-with-at-least-32-random-characters
# Chỉ đặt trên máy chủ qua secret manager khi bật luồng Writing 56/67; 64 ký tự hex ngẫu nhiên.
# WRITING_FLOW_ENCRYPTION_KEY=
