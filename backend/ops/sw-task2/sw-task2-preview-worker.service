[Unit]
Description=SW Task 2 isolated preview worker
After=docker.service network-online.target
[Service]
Type=simple
Environment=SW_PREVIEW_WORKER_CONFIG=/opt/izone-sw-task2-preview-20261025/worker-config.private.json
ExecStart=/usr/bin/python3 /opt/izone-sw-task2-preview-20261025/worker.py
Restart=on-failure
RestartSec=10
StateDirectory=sw-task2-preview-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
CPUQuota=25%
[Install]
WantedBy=multi-user.target
